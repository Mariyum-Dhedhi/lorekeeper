# Which LLM to use: "ollama" (free, local) or "groq" (free tier, cloud)
LLM_PROVIDER=ollama

# Ollama (install from https://ollama.com, then: ollama pull qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Groq free tier (get a key at https://console.groq.com/keys)
# Check https://console.groq.com/docs/models for current model names.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: use a different provider just for the LLM judge (e.g. a stronger grader)
# JUDGE_PROVIDER=groq

# Optional: run the checking agent (premise and grounding checks) on another provider,
# so answers are not only checked by the model that wrote them
# CHECKER_PROVIDER=groq

# Retrieval
TOP_K=4
HYBRID=true

# Vector store: "chroma" (embedded, no setup) or "pgvector" (PostgreSQL; start it with
# `docker compose up -d db`). 127.0.0.1 rather than localhost avoids slow IPv6 lookups on Windows.
VECTOR_STORE=chroma
DATABASE_URL=postgresql://lorekeeper:lorekeeper@127.0.0.1:5432/lorekeeper
